{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1240px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "salt", "name": "Salt · ملح", "color": "#F7F4EE" },
				{ "slug": "sand", "name": "Sand · رمل", "color": "#ECE5D9" },
				{ "slug": "mist", "name": "Mist · ضباب البحر", "color": "#E4ECE9" },
				{ "slug": "deep", "name": "Deep Sea · عمق البحر", "color": "#12343A" },
				{ "slug": "mineral", "name": "Mineral · معدني", "color": "#2D7A78" },
				{ "slug": "moab", "name": "Moab · جبال مؤاب", "color": "#B4613A" },
				{ "slug": "moab-deep", "name": "Moab deep (text)", "color": "#8E4A2A" },
				{ "slug": "ink", "name": "Ink · حبر", "color": "#0F1B1E" },
				{ "slug": "muted", "name": "Muted text", "color": "#58625F" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "IBM Plex Sans Arabic",
					"fontFamily": "\"IBM Plex Sans Arabic\", \"Segoe UI\", Tahoma, sans-serif",
					"fontFace": [
						{ "fontFamily": "IBM Plex Sans Arabic", "fontWeight": "300", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/plex-arabic-300.woff2" ] },
						{ "fontFamily": "IBM Plex Sans Arabic", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/plex-arabic-400.woff2" ] },
						{ "fontFamily": "IBM Plex Sans Arabic", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/plex-arabic-500.woff2" ] },
						{ "fontFamily": "IBM Plex Sans Arabic", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/plex-arabic-600.woff2" ] }
					]
				},
				{
					"slug": "display",
					"name": "Noto Naskh Arabic + Bodoni Moda",
					"fontFamily": "\"Bodoni Moda\", \"Noto Naskh Arabic\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Noto Naskh Arabic", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-naskh-arabic.woff2" ] },
						{ "fontFamily": "Bodoni Moda", "fontWeight": "400 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/bodoni-moda.woff2" ] },
						{ "fontFamily": "Bodoni Moda", "fontWeight": "400 900", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/bodoni-moda-italic.woff2" ] }
					]
				},
				{
					"slug": "latin",
					"name": "Bodoni Moda",
					"fontFamily": "\"Bodoni Moda\", Georgia, serif"
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "XS", "size": "0.8125rem", "fluid": false },
				{ "slug": "sm", "name": "S", "size": "0.9375rem", "fluid": false },
				{ "slug": "md", "name": "M", "size": "1.0625rem", "fluid": false },
				{ "slug": "lg", "name": "L", "size": "1.3125rem", "fluid": { "min": "1.15rem", "max": "1.3125rem" } },
				{ "slug": "xl", "name": "XL", "size": "2.125rem", "fluid": { "min": "1.65rem", "max": "2.125rem" } },
				{ "slug": "xxl", "name": "XXL", "size": "3.5rem", "fluid": { "min": "2.4rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "2XS", "size": "0.5rem" },
				{ "slug": "30", "name": "XS", "size": "0.75rem" },
				{ "slug": "40", "name": "S", "size": "1rem" },
				{ "slug": "50", "name": "M", "size": "1.5rem" },
				{ "slug": "60", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "70", "name": "XL", "size": "clamp(3rem, 7vw, 5.5rem)" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--salt)", "text": "var(--wp--preset--color--ink)" },
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "max(16px, 4vw)", "right": "max(16px, 4vw)" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--md)",
			"fontWeight": "400",
			"lineHeight": "1.75",
			"letterSpacing": "normal"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--deep)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--moab-deep)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.35", "letterSpacing": "normal" },
				"color": { "text": "var(--wp--preset--color--deep)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)", "lineHeight": "1.3" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)", "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--deep)", "text": "var(--wp--preset--color--salt)" },
				"border": { "radius": "2px" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.75rem", "right": "1.75rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "500", "fontSize": "var(--wp--preset--font-size--sm)", "textDecoration": "none" },
				":hover": { "color": { "background": "var(--wp--preset--color--mineral)", "text": "var(--wp--preset--color--white)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--moab)", "offset": "3px", "style": "solid", "width": "2px" } }
			},
			"caption": { "typography": { "fontSize": "var(--wp--preset--font-size--xs)" }, "color": { "text": "var(--wp--preset--color--muted)" } }
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--sm)", "fontWeight": "500" }, "elements": { "link": { "typography": { "textDecoration": "none" } } } },
			"core/details": { "border": { "bottom": { "color": "#DCD4C6", "width": "1px", "style": "solid" } }, "spacing": { "padding": { "top": "1rem", "bottom": "1rem" } } },
			"core/separator": { "color": { "text": "#DCD4C6" } },
			"woocommerce/product-price": { "typography": { "fontWeight": "600" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-plain", "title": "صفحة بدون عنوان", "postTypes": [ "page" ] }
	]
}
